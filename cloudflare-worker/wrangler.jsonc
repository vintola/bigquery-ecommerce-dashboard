{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alvintola-dashboard-proxy",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-02",
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_ORIGIN": "https://alvintola-retail-dashboard.streamlit.app"
  },
  "routes": [
    { "pattern": "dashboard.alvintola.com", "custom_domain": true }
  ]
}
